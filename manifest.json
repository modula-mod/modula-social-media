{
  "id": "social-media",
  "slug": "social-media",
  "name": "Social Media",
  "subtitle": "Identity-native flagship social module for Modula",
  "description": "Unified social feed module for Modula with a real feed, composer, comments, reactions, activity, widgets, plugin extension points, and a componentized package structure.",
  "version": "1.6.1",
  "type": "module",
  "entry": "module.json",
  "frontend": {
    "framework": "svelte",
    "mode": "svelte_component",
    "build_dir": "frontend/dist",
    "entry": "frontend/dist/modula-entry.js",
    "style": "frontend/dist/modula-entry.css",
    "fallback_entry": "index.html"
  },
  "icon": "icon.svg",
  "publisher": "modula",
  "category": "core",
  "repository": "https://github.com/modula-mod/modula-social-media",
  "assets": {
    "icon": "icon.svg",
    "cover": "cover.png"
  },
  "support": {
    "docs": "./docs",
    "issues": "https://github.com/modula-mod/modula-social-media/issues"
  },
  "release": {
    "current": "1.6.1",
    "channel": "stable"
  },
  "compatibility": {
    "modula_core": ">=1.0.0",
    "api_version": "1"
  },
  "permissions": [
    "social.feed.read",
    "social.post.create",
    "social.comment.create",
    "social.reaction.create",
    "social.explore.read",
    "social.profile.extend",
    "social.widget.read",
    "social.notification.emit"
  ],
  "risk_tier": "A",
  "tags": [
    "social",
    "feed",
    "community",
    "profile",
    "board"
  ],
  "functions": [
    {
      "id": "social.create_post",
      "title": "Create post",
      "permission": "social.post.create"
    },
    {
      "id": "social.list_feed",
      "title": "List feed",
      "permission": "social.feed.read"
    },
    {
      "id": "social.react_to_post",
      "title": "React to post",
      "permission": "social.reaction.create"
    },
    {
      "id": "social.comment_on_post",
      "title": "Comment on post",
      "permission": "social.comment.create"
    },
    {
      "id": "social.search_posts",
      "title": "Search posts",
      "permission": "social.explore.read"
    },
    {
      "id": "social.get_profile_activity",
      "title": "Get profile activity",
      "permission": "social.profile.extend"
    }
  ],
  "widgets": [
    {
      "id": "social-feed-widget",
      "title": "Social Feed Widget",
      "surface": "board"
    },
    {
      "id": "social-stats-widget",
      "title": "Social Stats Widget",
      "surface": "board"
    },
    {
      "id": "recent-comments-widget",
      "title": "Recent Comments Widget",
      "surface": "board"
    },
    {
      "id": "trending-posts-widget",
      "title": "Trending Posts Widget",
      "surface": "explore"
    }
  ],
  "notifications": [
    {
      "id": "social.comment.created",
      "title": "Comment created",
      "default_enabled": true
    },
    {
      "id": "social.reaction.created",
      "title": "Reaction created",
      "default_enabled": true
    },
    {
      "id": "social.post.created",
      "title": "Post created",
      "default_enabled": true
    }
  ],
  "events": [
    {
      "id": "social.post.created",
      "direction": "emitted"
    },
    {
      "id": "social.comment.created",
      "direction": "emitted"
    },
    {
      "id": "social.reaction.created",
      "direction": "emitted"
    },
    {
      "id": "social.search.requested",
      "direction": "accepted"
    }
  ],
  "capabilities": [
    "social.feed.read",
    "social.post.create",
    "social.comment.create",
    "social.reaction.create",
    "social.explore.read",
    "social.profile.extend",
    "social.widget.read",
    "social.notification.emit"
  ]
}
